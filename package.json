{
  "name": "lyric-wall",
  "productName": "Lyric Wall",
  "version": "0.1.1",
  "description": "Music wallpaper: the current Spotify track and synced lyrics right on your desktop",
  "main": "main/main.js",
  "author": "pe4enku0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-mac-helper.js",
    "start": "electron .",
    "prewindow": "node scripts/build-mac-helper.js",
    "window": "electron . --window",
    "predist": "node scripts/build-mac-helper.js",
    "dist": "electron-builder --publish never",
    "install-app": "npm run dist && node scripts/install-mac-app.js"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/vt323": "^5.3.0",
    "koffi": "^3.3.5"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.pe4enku0.lyricwall",
    "productName": "Lyric Wall",
    "copyright": "pe4enku0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!mockup.html",
      "!README*.md",
      "!.git/**",
      "!.github/**",
      "!dist/**",
      "!native/**",
      "!mac-helper/**",
      "!scripts/**"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Lyric-Wall-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "Lyric Wall reads the current Spotify track and controls playback.",
        "NSAudioCaptureUsageDescription": "Lyric Wall listens to the music playing on this Mac to move the Sound bars. Nothing is recorded or sent anywhere."
      },
      "icon": "assets/icon-mac.png",
      "extraResources": [
        {
          "from": "native/mac/lyric-wall-clicks",
          "to": "lyric-wall-clicks"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lyric-Wall-Setup-${version}.${ext}",
      "icon": "assets/icon-win.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Lyric Wall",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "adapters/win-media.ps1",
      "adapters/win-audio.ps1"
    ]
  },
  "allowScripts": {
    "koffi": false,
    "electron-winstaller": false
  }
}
