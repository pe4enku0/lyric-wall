{
  "name": "lyric-wall",
  "productName": "Lyric Wall",
  "version": "0.1.0",
  "description": "Музыкальные обои: что играет в Spotify и текст песни прямо на рабочем столе",
  "main": "main/main.js",
  "author": "pe4enku0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.pe4enku0.lyricwall",
    "productName": "Lyric Wall",
    "copyright": "pe4enku0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!mockup.html",
      "!README.md",
      "!.github/**",
      "!dist/**"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Lyric-Wall-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Lyric-Wall-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
